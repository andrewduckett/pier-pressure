// Renovate's rules for this repository (#119, ADR-0024). The runner settings,
// such as the token and the one allowed command, live in
// .github/workflows/renovate.yml, where a repository config can't widen them.
//
// Minor and patch updates arrive weekly, as one pull request per ecosystem. Each
// major update and each Let's Spec update arrives on its own. CI decides whether
// an update is safe; nothing merges automatically.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    // Reads the `# renovate:` comments on the Renovate and Node pins in the workflow.
    "customManagers:githubActionsVersions",
  ],
  // The whole of Monday, so a manual rerun that day still counts.
  schedule: ["on monday"],
  timezone: "UTC",
  // Renovate runs once a day, so the default of two new pull requests an hour
  // would hold updates back for days.
  prHourlyLimit: 0,
  // The main ruleset requires an up-to-date branch, which Renovate can't read.
  rebaseWhen: "behind-base-branch",
  labels: ["dependencies"],
  // The commit prefixes Dependabot used: build(deps), and ci(deps) for Actions.
  semanticCommits: "enabled",
  semanticCommitType: "build",
  semanticCommitScope: "deps",
  // Security pull requests already skip the schedule and the groups, and their
  // titles end with [SECURITY].
  vulnerabilityAlerts: {
    addLabels: ["security"],
  },
  // Python changes only by a hand edit to .python-version.
  pyenv: {
    enabled: false,
  },
  // A release inside the listed range moves uv.lock and leaves pyproject.toml alone.
  pep621: {
    rangeStrategy: "update-lockfile",
  },
  // A later rule wins over an earlier one.
  packageRules: [
    // 1. One weekly pull request per ecosystem for minor and patch updates.
    // Majors match no group, so each arrives on its own.
    {
      matchManagers: ["pep621"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "uv minor and patch",
    },
    {
      matchManagers: ["github-actions", "custom.regex"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "GitHub Actions minor and patch",
    },
    {
      matchManagers: ["dockerfile", "docker-compose"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "Docker minor and patch",
    },
    {
      matchManagers: ["mise"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "mise.toml minor and patch",
    },
    // 2. Anything in the workflows is CI, including the Renovate and Node pins.
    {
      matchFileNames: [".github/workflows/**"],
      semanticCommitType: "ci",
    },
    // 3. Let's Spec on its own, so its rule changes can be reviewed and reverted
    // alone. `lets sync` writes the skills, schemas and AGENTS.md block the new
    // version ships; the runner allows no other command.
    {
      matchPackageNames: ["sidereal-io/lets-spec"],
      groupName: "Let's Spec",
      postUpgradeTasks: {
        commands: ["lets sync"],
        fileFilters: ["**/*"],
        executionMode: "branch",
      },
    },
    // 4. uv is 0.x, so a minor can break. It must stay inside [tool.uv]
    // required-version in pyproject.toml, so a new minor is a hand change.
    {
      matchPackageNames: ["astral-sh/uv", "ghcr.io/astral-sh/uv"],
      matchUpdateTypes: ["minor", "major"],
      enabled: false,
    },
    // 5. Never Python, whichever manager finds it: requires-python, the
    // Dockerfile's base image or .python-version.
    {
      matchDepNames: ["python"],
      enabled: false,
    },
  ],
}
